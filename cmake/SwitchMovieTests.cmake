set(MOON_FFMPEG_TEST_ROOT "" CACHE PATH "Local host FFmpeg libraries for Switch movie tests")
set(MOON_MOVIE_TEST_DIR "" CACHE PATH "Local PSS and independent CLI RGBA references")
if(MOON_FFMPEG_TEST_ROOT)
  add_executable(switch_movie_test tests/platform/switch_movie.c src/platform/switch/movie_decode.c)
  target_include_directories(switch_movie_test PRIVATE "${MOON_FFMPEG_TEST_ROOT}/include" src/platform/sdl)
  target_link_libraries(switch_movie_test PRIVATE moon_core moon_platform_common SDL2::SDL2-static SDL2::SDL2main)
  foreach(LIBRARY avfilter avformat avcodec swscale avutil)
    target_link_libraries(switch_movie_test PRIVATE "${MOON_FFMPEG_TEST_ROOT}/lib/lib${LIBRARY}.a")
  endforeach()
  if(WIN32)
    target_link_libraries(switch_movie_test PRIVATE bcrypt)
  endif()
  add_executable(switch_movie_ipic tests/ui/movie_ipic.c src/platform/switch/movie_ffmpeg.c
    src/platform/switch/movie_decode.c src/platform/sdl/movie.c)
  target_compile_definitions(switch_movie_ipic PRIVATE MOON_SWITCH_MOVIES=1)
  target_include_directories(switch_movie_ipic PRIVATE "${MOON_FFMPEG_TEST_ROOT}/include" src/platform/sdl)
  target_link_libraries(switch_movie_ipic PRIVATE moon_core moon_platform_sdl moon_platform_common SDL2::SDL2main)
  foreach(LIBRARY avfilter avformat avcodec swscale avutil)
    target_link_libraries(switch_movie_ipic PRIVATE "${MOON_FFMPEG_TEST_ROOT}/lib/lib${LIBRARY}.a")
  endforeach()
  if(WIN32)
    target_link_libraries(switch_movie_ipic PRIVATE bcrypt)
  endif()
  if(EXISTS "${MOON_TEST_DISC}")
    add_test(NAME switch_movie_ipic COMMAND switch_movie_ipic "${MOON_TEST_DISC}")
    add_test(NAME switch_movie_ipic_negative COMMAND switch_movie_ipic "${MOON_TEST_DISC}" --negative)
    set_tests_properties(switch_movie_ipic_negative PROPERTIES WILL_FAIL TRUE)
  endif()
  if(MOON_MOVIE_TEST_DIR)
    foreach(MOVIE start_game category opening_us)
      add_test(NAME switch_movie_${MOVIE} COMMAND switch_movie_test "${MOON_MOVIE_TEST_DIR}/${MOVIE}.pss" 1 "${MOON_MOVIE_TEST_DIR}/${MOVIE}-1.rgba")
    endforeach()
    add_test(NAME switch_movie_audio COMMAND switch_movie_test "${MOON_MOVIE_TEST_DIR}/opening_us.pss" 1 "${MOON_MOVIE_TEST_DIR}/opening_us-1.rgba" --audio)
    foreach(FIELDS 0 1)
      add_test(NAME switch_movie_loop_${FIELDS} COMMAND switch_movie_test "${MOON_MOVIE_TEST_DIR}/synthetic.pss" ${FIELDS} "${MOON_MOVIE_TEST_DIR}/synthetic-${FIELDS}.rgba" --loop)
    endforeach()
    add_test(NAME switch_movie_negative COMMAND switch_movie_test "${MOON_MOVIE_TEST_DIR}/synthetic.pss" 1 "${MOON_MOVIE_TEST_DIR}/synthetic-1.rgba" --negative)
    add_test(NAME switch_movie_fields_negative COMMAND switch_movie_test "${MOON_MOVIE_TEST_DIR}/synthetic.pss" 1 "${MOON_MOVIE_TEST_DIR}/synthetic-1.rgba" --field-negative)
    set_tests_properties(switch_movie_negative switch_movie_fields_negative PROPERTIES WILL_FAIL TRUE)
  endif()
endif()
