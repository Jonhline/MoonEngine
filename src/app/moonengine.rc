/* Program icon supplied by the user (res/moonengine.ico). */
1 ICON "../../res/moonengine.ico"

#include "launcher_release.h"
1 VERSIONINFO
 FILEVERSION MOON_VERSION_COMMAS
 PRODUCTVERSION MOON_VERSION_COMMAS
 FILEOS 0x40004
 FILETYPE 0x1
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "MoonEngine\0"
   VALUE "FileDescription", "Moon Engine\0"
   VALUE "FileVersion", MOON_VERSION "\0"
   VALUE "ProductName", "Moon Engine\0"
   VALUE "ProductVersion", MOON_VERSION "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
