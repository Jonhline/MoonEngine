/* Program icon supplied by the user (res/opengt4.ico). */
1 ICON "../../res/opengt4.ico"

#include "launcher_release.h"
1 VERSIONINFO
 FILEVERSION OPENGT4_VERSION_COMMAS
 PRODUCTVERSION OPENGT4_VERSION_COMMAS
 FILEOS 0x40004
 FILETYPE 0x1
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "OpenGT4\0"
   VALUE "FileDescription", "OpenGT4\0"
   VALUE "FileVersion", OPENGT4_VERSION "\0"
   VALUE "ProductName", "OpenGT4\0"
   VALUE "ProductVersion", OPENGT4_VERSION "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
