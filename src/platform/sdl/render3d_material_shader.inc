/* P: evaluate the authored material at the fragment rather than interpolating
   vertex-lit results. No inferred material classes, roughness or replacement lights.
   Original: func_0049EB90 +0x84..0x94 isolates specular-only colours.
   Original: func_0049E918 +0x100..0x150 chooses the race specular exponent. */
"uniform int u_material_shading, u_flat, u_specular_only, u_nlights, u_skip_material_light, u_measure_no_spec;\n"
    "uniform vec3 u_ldir[4],u_lamb[4],u_ldif[4],u_lspe[4];\n"
    "uniform float u_lspec_scale,u_lvertex; uniform vec2 u_envk;\n"
    "uniform vec3 u_r,u_u,u_f;\n"
    "in vec3 v_material_normal; in vec3 v_material_ray; in vec3 v_material_rgb; in vec3 v_material_amb; in vec3 v_material_spec;\n"
    "in float v_material_shine;\n"
    "void materialSample(inout vec3 light,inout vec3 spec,inout vec2 envuv){\n"
    "  if(u_material_shading==0) return;\n"
    "  if(u_skip_material_light==1) return;\n"
    "  vec3 n=v_material_normal/max(length(v_material_normal),1e-8);\n"
    "  vec3 ray=v_material_ray/max(length(v_material_ray),1e-8);\n"
    "  if(u_reflect==1){\n"
    "    vec3 nn=vec3(dot(n,u_r),dot(n,u_u),-dot(n,u_f));\n"
    "    vec3 i=normalize(vec3(dot(ray,u_r),dot(ray,u_u),-dot(ray,u_f)));\n"
    "    vec3 reflected=reflect(i,nn); reflected.z+=1.; float den=2.*length(reflected);\n"
    "    envuv=den>1e-8?vec2(.5+reflected.x/den,.5-reflected.y/den):vec2(.5);\n"
    "    light=v_material_rgb;spec=vec3(0.);\n"
    "    if(u_envk!=vec2(0.)) light*=u_envk.x+u_envk.y*min(dot(ray,n),0.);\n"
    "    return;\n"
    "  }\n"
    "  if(u_flat==1) return;\n"
    "  vec3 amb=vec3(0.),dif=vec3(0.),spe=vec3(0.);\n"
    "  if(u_nlights>0){\n"
    "    float exponent=v_material_shine;\n"
    "    if(u_lvertex>0.) exponent=v_material_shine<6.?4.:v_material_shine<12.?8.:16.;\n"
    "    for(int l=0;l<4;l++){if(l>=u_nlights)break;amb+=u_lamb[l];\n"
    "      float ll=length(u_ldir[l]);if(ll<1e-6)continue;vec3 ld=u_ldir[l]/ll;\n"
    "      float d=max(0.,dot(n,ld));vec3 h=ld-ray;float hl=length(h);\n"
    "      float s=u_measure_no_spec==1?0.:(d>0.&&hl>1e-6?pow(max(0.,dot(n,h/hl)),exponent):0.);\n"
    "      dif+=u_ldif[l]*d;spe+=u_lspe[l]*s;\n"
    "    }\n"
    "    light=v_material_amb*amb+v_material_rgb*dif;\n"
    "    spec=v_material_spec*spe*u_lspec_scale;\n"
    "    if(u_lvertex>0.){vec3 lit=v_material_spec*spe;\n"
    "      if(u_specular_only==0)lit+=light;\n"
    "      light=clamp(lit,vec3(0.),vec3(u_lvertex));spec=vec3(0.);\n"
    "    }else if(u_specular_only==1){light=spec;spec=vec3(0.);}\n"
    "  }else{\n"
    /* Existing studio fallback coefficients; the enhancement changes sampling,
   not the light rig. Explicit showroom and course lights use the branch above. */
    "    const vec3 L[3]=vec3[3](vec3(.57735,.57735,.57735),vec3(0.,.9759,-.2182),vec3(-1.,0.,0.));\n"
    "    const vec3 D=vec3(1.,60./255.,216./255.),S=vec3(239./255.,108./255.,198./255.);\n"
    "    float ds=0.,ss=0.;for(int l=0;l<3;l++){float d=max(0.,dot(n,L[l]));vec3 h=L[l]-ray;\n"
    "      ds+=D[l]*d;float hl=length(h);if(d>0.&&hl>1e-6)ss+=S[l]*pow(max(0.,dot(n,h/hl)),v_material_shine);}\n"
    "    light=50./255.*v_material_amb+v_material_rgb*ds;spec=v_material_spec*ss*.18;\n"
    "    if(u_specular_only==1){light=spec;spec=vec3(0.);}\n"
    "  }\n"
    "}\n"
